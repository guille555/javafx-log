<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
  xmlns:fx="http://javafx.com/fxml"
  stylesheets="@css/app.css"
  fx:controller="dev.sprout.main.controller.EntryEditController"
>
  <left>
    <fx:include
      source="SidebarView.fxml"
    />
  </left>
  <top>
    <HBox
      styleClass="header-panel"
    >
      <Label
        text="Edit entry"
        styleClass="app-title"
      />
    </HBox>
  </top>
  <center>
    <VBox
      style="-fx-padding: 0 16 0 16"
    >
      <VBox
        styleClass="form_field_container"
      >
        <Label
          text="Content:"
          styleClass="formLabel_new"
        />
        <TextArea
          fx:id="textAreaContent"
          styleClass="form_text_field, form_text_area"
        />
      </VBox>
      <HBox
        styleClass="form_buttons_panel"
      >
        <Button
          text="save"
          styleClass="form_button"
          onAction="#handleSave"
        />
        <Button
          text="return"
          styleClass="form_button"
          onAction="#handleReturn"
        />
      </HBox>
    </VBox>
  </center>
  <bottom>
    <VBox
      styleClass="footer-empty"
    />
  </bottom>
</BorderPane>
