<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
  xmlns:fx="http://javafx.com/fxml"
  stylesheets="@css/app.css"
  fx:controller="dev.sprout.main.controller.PhotoNewController"
>
  <left>
    <fx:include
      source="SidebarView.fxml"
    />
  </left>
  <top>
    <HBox
      styleClass="header-panel"
    >
      <Label
        text="New photo"
        styleClass="app-title"
      />
    </HBox>
  </top>
  <center>
    <VBox
      styleClass="header-panel--form-new"
    >
      <VBox
        styleClass="form_field_container"
      >
        <Label
          text="Photo:"
          styleClass="formLabel_new"
        />
        <TextField
          fx:id="textFieldName"
          styleClass="form_text_field"
          editable="false"
        />
      </VBox>
      <HBox
        styleClass="form_buttons_panel"
      >
        <Button
          text="open"
          styleClass="form_button"
          onAction="#handleFileChooser"
        />
        <Button
          text="save"
          styleClass="form_button"
          onAction="#handleSave"
        />
        <Button
          text="clear"
          styleClass="form_button"
          onAction="#handleClear"
        />
        <Button
          text="return"
          styleClass="form_button"
          onAction="#handleReturn"
        />
      </HBox>
    </VBox>
  </center>
  <bottom>
    <VBox
      styleClass="footer-empty"
    />
  </bottom>
</BorderPane>
